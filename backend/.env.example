# Backend environment variables. Placeholders only: never commit real values.
# Copy to backend/.env for local runs (the local profile imports it). In production set these in the
# hosting dashboard (Render), not in a file.

# ---------------------------------------------------------------------------
# Shared by all profiles
# ---------------------------------------------------------------------------
# Port for the application (default 8080; the Docker image sets 10000)
PORT=8080

# Google OAuth2 client (required in dev and prod; local falls back to "replace-me")
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# GitHub OAuth2 client (required in dev and prod: startup fails without it; local falls back to "replace-me")
GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret

# ---------------------------------------------------------------------------
# dev profile (application-dev.properties)
# ---------------------------------------------------------------------------
# MongoDB URI, bound to spring.mongodb.uri (not needed for the local profile)
MONGO_URI_DEV=mongodb://localhost:27017/chatmee

# ---------------------------------------------------------------------------
# prod profile (application-prod.properties). All are required: there is no default,
# so a missing value fails startup on an unresolved placeholder.
# ---------------------------------------------------------------------------
# Active profile; the Dockerfile already sets SPRING_PROFILES_ACTIVE=prod
# SPRING_PROFILES_ACTIVE=prod

# MongoDB URI (Atlas), bound to spring.mongodb.uri (Spring Boot 4 key; the old
# spring.data.mongodb.uri / SPRING_DATA_MONGODB_URI is ignored by Boot 4)
MONGO_URI_PROD=mongodb+srv://replace_user:replace_password@replace-cluster.example.net/chatmee

# Redis URL (Upstash), bound to spring.data.redis.url; use rediss:// for TLS
REDIS_URL=rediss://default:replace_password@replace-host.example.net:6379

# Public frontend URL, bound to app.client.url. Used for CORS, the WebSocket allowed origin and the
# OAuth2 redirect URIs ({APP_CLIENT_URL}/login/oauth2/code/google and .../github). No trailing slash.
APP_CLIENT_URL=https://replace-with-frontend-host.example.com

# Optional JVM flags read by the Docker entrypoint
# JAVA_OPTS=
