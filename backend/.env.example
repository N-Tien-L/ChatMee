# MongoDB URI for dev profile (not needed for local)
MONGO_URI_DEV=mongodb://localhost:27017/chatmee
# Port for the application (default 8080)
PORT=8080
# Google OAuth2 Client ID
GOOGLE_CLIENT_ID=replace_with_google_client_id
# Google OAuth2 Client Secret
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
# Github OAuth2 Client ID
GITHUB_CLIENT_ID=replace_with_github_client_id
# Github OAuth2 Client Secret
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
